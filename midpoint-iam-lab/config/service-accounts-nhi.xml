<!--
  Service Accounts (non-human identities) on the OpenLDAP resource.
  This is the second objectType in the OpenLDAP resource's schemaHandling
  (kind=account, intent=NHI), exported from the lab and trimmed of ids.

  How it works:
  - Delineation: only entries under ou=services,dc=idpnode,dc=net count as service accounts.
  - Ownership: each service account carries its owner's employee ID in carLicense.
    The inbound mapping carLicense -> name, plus correlation on name, links the
    service account to its owner's midPoint user (e.g. svc-backup -> 1002).
  - Orphans: the unmatched reaction has no action, so a service account with no
    owner is never turned into a midPoint user. It stays UNMATCHED and visible
    for review instead.
-->
<objectType xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
            xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
            xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
            xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3">
    <kind>account</kind>
    <intent>NHI</intent>
    <displayName>Service Accounts</displayName>
    <description>Link service accounts to their human owners</description>
    <lifecycleState>active</lifecycleState>

    <delineation>
        <objectClass>ri:inetOrgPerson</objectClass>
        <baseContext>
            <objectClass>ri:organizationalUnit</objectClass>
            <filter>
                <q:equal>
                    <q:path>attributes/ri:dn</q:path>
                    <q:value>ou=services,dc=idpnode,dc=net</q:value>
                </q:equal>
            </filter>
        </baseContext>
    </delineation>

    <focus>
        <type>c:UserType</type>
    </focus>

    <!-- Owner: the service account's carLicense holds the owner's employee ID -->
    <attribute>
        <ref>ri:carLicense</ref>
        <inbound>
            <name>owner for tech accounts</name>
            <strength>strong</strength>
            <target>
                <path>name</path>
            </target>
        </inbound>
    </attribute>

    <attribute>
        <ref>ri:cn</ref>
        <inbound>
            <name>nhi-name</name>
            <strength>strong</strength>
            <target>
                <path>additionalName</path>
            </target>
        </inbound>
    </attribute>

    <!-- Match the service account to the midPoint user whose name = owner's empid -->
    <correlation>
        <correlators>
            <items>
                <name>nhi correlation</name>
                <enabled>true</enabled>
                <item>
                    <ref>name</ref>
                </item>
            </items>
        </correlators>
    </correlation>

    <synchronization>
        <reaction>
            <situation>linked</situation>
            <actions>
                <synchronize/>
            </actions>
        </reaction>
        <reaction>
            <situation>unlinked</situation>
            <actions>
                <link/>
            </actions>
        </reaction>
        <!-- No action: an ownerless service account is flagged, never auto-created as a user -->
        <reaction>
            <situation>unmatched</situation>
        </reaction>
    </synchronization>
</objectType>
